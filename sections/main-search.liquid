{%- paginate search.results by 12 -%}
<section class="section wrap">
  <h1 class="h2">Hanapin / Search</h1>
  <form action="{{ routes.search_url }}" method="get" class="searchbar" role="search">
    <input type="hidden" name="type" value="product">
    <label class="sr" for="q">Search products</label>
    <input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Kape, mangga, habi…">
    <button class="btn" type="submit">Hanapin</button>
  </form>
  {%- if search.performed -%}
    <p>{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for “{{ search.terms | escape }}”</p>
    <div class="grid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endif -%}
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Search page", "settings": [] }
{% endschema %}
