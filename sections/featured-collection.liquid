{%- assign col = section.settings.collection -%}
{%- if col == blank -%}{%- assign col = collections.all -%}{%- endif -%}
<section class="section wrap">
  <div class="sec-head">
    <h2>{{ section.settings.heading | escape }}</h2>
    <a class="more" href="{{ col.url }}">Tingnan lahat / View all</a>
  </div>
  <div class="grid">
    {%- for product in col.products limit: section.settings.limit -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      <p>Add products to this collection to see them here.</p>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mga bestseller" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 2, "label": "Number of products", "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
